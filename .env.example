# Copia este archivo a .env para desarrollo local. Nunca subas .env a git.

# Postgres (docker compose)
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# Backend
DATABASE_URL=postgresql+psycopg://todo:todo@localhost:5432/todo
CORS_ORIGINS=http://localhost:5173

# Sesión en cookie httpOnly. Orígenes desde los que se aceptan peticiones que modifican datos (CSRF):
# la app (Vite) y /api/docs.
APP_ORIGINS=http://localhost:5173,http://localhost:8000
# true en producción (HTTPS); false en local porque es http.
COOKIE_SECURE=false

# Login con Google (Google Identity Services). Vacío = desactivado.
# ID de cliente OAuth "Aplicación web" con origen autorizado http://localhost:5173.
GOOGLE_CLIENT_ID=
